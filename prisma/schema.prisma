// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Global user table - 1 user bisa punya multiple commerce_accounts
model User {
  id              BigInt    @id @default(autoincrement())
  email           String    @unique @db.VarChar(255)
  password        String    @db.VarChar(255)
  name            String    @db.VarChar(255)
  phone           String?   @db.VarChar(20)
  emailVerifiedAt DateTime? @map("email_verified_at")
  avatarUrl       String?   @map("avatar_url") @db.VarChar(500)
  createdAt       DateTime? @default(now()) @map("created_at")
  updatedAt       DateTime? @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  ownedCommerceAccounts      CommerceAccount[]       @relation("CommerceAccountOwner")
  commerceAccountMemberships CommerceAccountMember[] @relation("CommerceAccountMembers")
  authoredAiPromptVersions   AiPromptVersion[]       @relation("AiPromptVersionAuthor")
  aiGenerations              AiGeneration[]          @relation("AiGenerationUser")

  @@map("users")
}

model CommerceAccount {
  id          BigInt    @id @default(autoincrement())
  ownerUserId BigInt    @map("owner_user_id")
  slug        String    @unique @db.VarChar(100)
  name        String    @db.VarChar(255)
  description String?   @db.Text
  status      String    @default("pending_verification") @db.VarChar(30)
  createdAt   DateTime? @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  ownerUser  User                    @relation("CommerceAccountOwner", fields: [ownerUserId], references: [id])
  members    CommerceAccountMember[]
  shops         Shop[]
  categories    Category[]
  products      Product[]
  channels      Channel[]
  aiGenerations AiGeneration[]

  @@index([slug])
  @@index([status])
  @@map("commerce_accounts")
}

model CommerceAccountMember {
  id                BigInt    @id @default(autoincrement())
  commerceAccountId BigInt    @map("commerce_account_id")
  userId            BigInt    @map("user_id")
  role              String    @db.VarChar(30)
  createdAt         DateTime? @default(now()) @map("created_at")
  updatedAt         DateTime? @updatedAt @map("updated_at")

  commerceAccount CommerceAccount @relation(fields: [commerceAccountId], references: [id])
  user            User            @relation("CommerceAccountMembers", fields: [userId], references: [id])

  @@unique([commerceAccountId, userId])
  @@map("commerce_account_members")
}

model Address {
  id              BigInt    @id @default(autoincrement())
  addressableType String    @map("addressable_type") @db.VarChar(100)
  addressableId   BigInt    @map("addressable_id")
  label           String?   @db.VarChar(50)
  recipientName   String    @map("recipient_name") @db.VarChar(255)
  phone           String    @db.VarChar(20)
  provinceId      Int       @map("province_id")
  cityId          Int       @map("city_id")
  subdistrictId   Int?      @map("subdistrict_id")
  postalCode      String?   @map("postal_code") @db.VarChar(10)
  streetAddress   String    @map("street_address") @db.Text
  isDefault       Boolean   @default(false) @map("is_default")
  createdAt       DateTime? @default(now()) @map("created_at")
  updatedAt       DateTime? @updatedAt @map("updated_at")

  @@index([addressableType, addressableId])
  @@map("addresses")
}
