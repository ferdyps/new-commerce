// Domain: Order

model Cart {
  id              BigInt    @id @default(autoincrement())
  channelId       BigInt    @map("channel_id")
  userId          BigInt?   @map("user_id")
  sessionId       String?   @map("session_id") @db.VarChar(64)
  affiliateLinkId BigInt?   @map("affiliate_link_id")
  createdAt       DateTime? @default(now()) @map("created_at")
  updatedAt       DateTime? @updatedAt @map("updated_at")

  channel       Channel        @relation(fields: [channelId], references: [id])
  user          User?          @relation(fields: [userId], references: [id])
  affiliateLink AffiliateLink? @relation(fields: [affiliateLinkId], references: [id])
  items         CartItem[]

  @@index([userId])
  @@index([sessionId])
  @@index([channelId])
  @@map("carts")
}

model CartItem {
  id                   BigInt    @id @default(autoincrement())
  cartId               BigInt    @map("cart_id")
  productId            BigInt    @map("product_id")
  productVariantId     BigInt?   @map("product_variant_id")
  quantity             Int       @default(1)
  unitPriceSnapshot    Decimal   @map("unit_price_snapshot") @db.Decimal(12, 2)
  createdAt            DateTime? @default(now()) @map("created_at")
  updatedAt            DateTime? @updatedAt @map("updated_at")

  cart           Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id])
  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id])

  @@index([cartId])
  @@map("cart_items")
}

model Order {
  id                        BigInt    @id @default(autoincrement())
  orderNumber               String    @unique @map("order_number") @db.VarChar(30)
  commerceAccountId         BigInt    @map("commerce_account_id")
  shopId                    BigInt    @map("shop_id")
  channelId                 BigInt?   @map("channel_id")
  customerUserId            BigInt?   @map("customer_user_id")
  customerEmail             String    @map("customer_email") @db.VarChar(255)
  customerPhone             String    @map("customer_phone") @db.VarChar(20)
  customerName              String    @map("customer_name") @db.VarChar(255)
  shippingAddress           Json      @map("shipping_address")
  subtotal                  Decimal   @db.Decimal(12, 2)
  shippingCost              Decimal   @default(0) @map("shipping_cost") @db.Decimal(12, 2)
  discountTotal             Decimal   @default(0) @map("discount_total") @db.Decimal(12, 2)
  total                     Decimal   @db.Decimal(12, 2)
  currency                  String    @default("IDR") @db.VarChar(3)
  status                    String    @default("pending") @db.VarChar(30)
  paymentStatus             String    @default("pending") @map("payment_status") @db.VarChar(20)
  shipmentStatus            String    @default("pending") @map("shipment_status") @db.VarChar(20)
  affiliateId               BigInt?   @map("affiliate_id")
  affiliateCommissionAmount Decimal?  @default(0) @map("affiliate_commission_amount") @db.Decimal(12, 2)
  notes                     String?   @db.Text
  placedAt                  DateTime  @map("placed_at")
  paidAt                    DateTime? @map("paid_at")
  createdAt                 DateTime? @default(now()) @map("created_at")
  updatedAt                 DateTime? @updatedAt @map("updated_at")
  deletedAt                 DateTime? @map("deleted_at")

  commerceAccount      CommerceAccount       @relation(fields: [commerceAccountId], references: [id])
  shop                 Shop                  @relation(fields: [shopId], references: [id])
  channel              Channel?              @relation(fields: [channelId], references: [id])
  customerUser         User?                 @relation(fields: [customerUserId], references: [id])
  affiliate            Affiliate?            @relation(fields: [affiliateId], references: [id])
  items                OrderItem[]
  payments             Payment[]
  shipments            Shipment[]
  affiliateCommissions AffiliateCommission[]

  @@index([orderNumber])
  @@index([commerceAccountId, status])
  @@index([customerUserId])
  @@index([affiliateId])
  @@map("orders")
}

model OrderItem {
  id                      BigInt    @id @default(autoincrement())
  orderId                 BigInt    @map("order_id")
  productId               BigInt?   @map("product_id")
  productVariantId        BigInt?   @map("product_variant_id")
  productNameSnapshot     String    @map("product_name_snapshot") @db.VarChar(255)
  variantOptionsSnapshot  Json?     @map("variant_options_snapshot")
  unitPrice               Decimal   @map("unit_price") @db.Decimal(12, 2)
  quantity                Int
  subtotal                Decimal   @db.Decimal(12, 2)
  weightGrams             Int       @default(0) @map("weight_grams")
  createdAt               DateTime? @default(now()) @map("created_at")
  updatedAt               DateTime? @updatedAt @map("updated_at")

  order          Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product?              @relation(fields: [productId], references: [id])
  productVariant ProductVariant?       @relation(fields: [productVariantId], references: [id])
  affiliateCommissions AffiliateCommission[]

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id                    BigInt    @id @default(autoincrement())
  orderId               BigInt    @map("order_id")
  provider              String    @db.VarChar(30)
  providerTransactionId String?   @unique @map("provider_transaction_id") @db.VarChar(100)
  paymentMethod         String    @map("payment_method") @db.VarChar(30)
  amount                Decimal   @db.Decimal(12, 2)
  status                String    @default("pending") @db.VarChar(20)
  rawResponse           Json?     @map("raw_response")
  qrisPayload           String?   @map("qris_payload") @db.Text
  expiresAt             DateTime? @map("expires_at")
  paidAt                DateTime? @map("paid_at")
  createdAt             DateTime? @default(now()) @map("created_at")
  updatedAt             DateTime? @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([providerTransactionId])
  @@index([status])
  @@map("payments")
}

model Shipment {
  id             BigInt    @id @default(autoincrement())
  orderId        BigInt    @map("order_id")
  courier        String    @db.VarChar(30)
  service        String    @db.VarChar(30)
  trackingNumber String?   @map("tracking_number") @db.VarChar(100)
  shippingCost   Decimal   @map("shipping_cost") @db.Decimal(12, 2)
  weightGrams    Int       @map("weight_grams")
  status         String    @default("pending") @db.VarChar(20)
  shippedAt      DateTime? @map("shipped_at")
  deliveredAt    DateTime? @map("delivered_at")
  createdAt      DateTime? @default(now()) @map("created_at")
  updatedAt      DateTime? @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([trackingNumber])
  @@map("shipments")
}

model ShippingRateCache {
  id                      BigInt    @id @default(autoincrement())
  originSubdistrictId     Int       @map("origin_subdistrict_id")
  destinationSubdistrictId Int      @map("destination_subdistrict_id")
  weightGrams             Int       @map("weight_grams")
  courier                 String    @db.VarChar(30)
  service                 String    @db.VarChar(30)
  cost                    Decimal   @db.Decimal(12, 2)
  etdMinDays              Int?      @map("etd_min_days")
  etdMaxDays              Int?      @map("etd_max_days")
  expiresAt               DateTime  @map("expires_at")
  createdAt               DateTime? @default(now()) @map("created_at")
  updatedAt               DateTime? @updatedAt @map("updated_at")

  @@unique([originSubdistrictId, destinationSubdistrictId, weightGrams, courier, service])
  @@index([expiresAt])
  @@map("shipping_rate_cache")
}
