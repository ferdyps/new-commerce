// Domain: Shop & Product

model Shop {
  id                BigInt    @id @default(autoincrement())
  commerceAccountId BigInt    @map("commerce_account_id")
  slug              String    @unique @db.VarChar(100)
  name              String    @db.VarChar(255)
  description       String?   @db.Text
  logoUrl           String?   @map("logo_url") @db.VarChar(500)
  bannerUrl         String?   @map("banner_url") @db.VarChar(500)
  contactEmail      String?   @map("contact_email") @db.VarChar(255)
  contactPhone      String?   @map("contact_phone") @db.VarChar(20)
  status            String    @default("active") @db.VarChar(20)
  createdAt         DateTime? @default(now()) @map("created_at")
  updatedAt         DateTime? @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  commerceAccount CommerceAccount @relation(fields: [commerceAccountId], references: [id])
  products        Product[]

  @@index([commerceAccountId])
  @@index([slug])
  @@map("shops")
}

model Category {
  id                BigInt    @id @default(autoincrement())
  commerceAccountId BigInt    @map("commerce_account_id")
  parentId          BigInt?   @map("parent_id")
  name              String    @db.VarChar(255)
  slug              String    @db.VarChar(100)
  iconUrl           String?   @map("icon_url") @db.VarChar(500)
  sortOrder         Int       @default(0) @map("sort_order")
  createdAt         DateTime? @default(now()) @map("created_at")
  updatedAt         DateTime? @updatedAt @map("updated_at")

  commerceAccount CommerceAccount @relation(fields: [commerceAccountId], references: [id])
  parent          Category?       @relation("CategoryTree", fields: [parentId], references: [id])
  children        Category[]      @relation("CategoryTree")
  products        Product[]

  @@unique([commerceAccountId, slug])
  @@index([parentId])
  @@map("categories")
}

model Product {
  id                BigInt    @id @default(autoincrement())
  commerceAccountId BigInt    @map("commerce_account_id")
  shopId            BigInt    @map("shop_id")
  categoryId        BigInt?   @map("category_id")
  name              String    @db.VarChar(255)
  slug              String    @db.VarChar(255)
  description       String?   @db.Text
  featuredImageUrl  String?   @map("featured_image_url") @db.VarChar(500)
  hasVariants       Boolean   @default(false) @map("has_variants")
  basePrice         Decimal?  @map("base_price") @db.Decimal(12, 2)
  baseStock         Int       @default(0) @map("base_stock")
  baseSku           String?   @map("base_sku") @db.VarChar(100)
  weightGrams       Int       @default(0) @map("weight_grams")
  status            String    @default("draft") @db.VarChar(20)
  createdAt         DateTime? @default(now()) @map("created_at")
  updatedAt         DateTime? @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  commerceAccount CommerceAccount  @relation(fields: [commerceAccountId], references: [id])
  shop            Shop             @relation(fields: [shopId], references: [id])
  category        Category?        @relation(fields: [categoryId], references: [id])
  images          ProductImage[]
  variants        ProductVariant[]

  @@unique([commerceAccountId, slug])
  @@index([commerceAccountId, status])
  @@index([shopId])
  @@map("products")
}

model ProductImage {
  id        BigInt    @id @default(autoincrement())
  productId BigInt    @map("product_id")
  url       String    @db.VarChar(500)
  altText   String?   @map("alt_text") @db.VarChar(255)
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id          BigInt    @id @default(autoincrement())
  productId   BigInt    @map("product_id")
  sku         String    @unique @db.VarChar(100)
  options     Json
  price       Decimal   @db.Decimal(12, 2)
  stock       Int       @default(0)
  weightGrams Int       @default(0) @map("weight_grams")
  imageUrl    String?   @map("image_url") @db.VarChar(500)
  createdAt   DateTime? @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_variants")
}
